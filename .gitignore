# ===========================
# StanceAI — Root .gitignore
# ===========================

# ── Environment / Secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# ── Python / Backend ─────────────────────────────────────────────────────
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.so
.pytest_cache/
.mypy_cache/

# ── Node / Frontend ───────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Media files (don't commit sample videos/images to the repo) ──────────
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.jpg
*.jpeg
*.png
*.gif
*.webp
# Exceptions: public assets and SVG icons are OK
!public/**/*.png
!public/**/*.jpg
!public/**/*.svg
!src/**/*.svg

# ── IDE / Editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.history/

# ── OS ────────────────────────────────────────────────────────────────────
*.DS_Store
Thumbs.db
desktop.ini

# ── Misc ─────────────────────────────────────────────────────────────────
*.cache
wallet/
*.dmp
